<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the DSP core (no SDR# needed): synthetic FM signals with exactly known levels are fed in as IQ,
       as SDR# would, and the measurements are compared with the expected values. Run with: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Dsp/*.cs" Link="Dsp/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
